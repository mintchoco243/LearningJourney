ng(0,r)),t&&(a=t.startsWith("#")?t:"#".concat(t)),"/"!==i&&i.startsWith("/")&&(i+=".html");let c=new URLSearchParams(s);n&&Object.entries(n).forEach(e=>{let[n,t]=e;c.set(n,t)});let l=i,d=c.toString();return d&&(l+="?".concat(d)),l+=a},r=e=>{let{href:n,searchParams:t,className:a,target:r,children:c}=e,l=o(n,t);return(0,i.jsx)(s(),{href:l,className:a,target:r,children:c})}},33022:function(e,n,t){"use strict";t.d(n,{G:function(){return r}});var i=t(85893),a=t(93967),s=t.n(a);let o=t(4147).i8,r=e=>{let{className:n,...t}=e;return(0,i.jsxs)("div",{className:s()("text-[12px] text-a/neutral/foreground/tertiary text-center",n),children:["v",o]})}},33046:function(e,n,t){"use strict";t.r(n);var i=t(85893),a=t(71763);n.default=()=>(0,i.jsx)(a.Io,{title:"Chat Completion",description:"API documentation for integrating with the Chat Completion system",content:'\n# Expert Chat\n\nIntegration API for creating custom chat experiences with Alpha Knowledge experts.\n\n## Overview\n\nThe Chat Completion API allows you to integrate Alpha Knowledge experts into your applications. After creating an expert and uploading knowledge in the portal, you can use this API to build custom chat interfaces.\n\n## API Reference\n\n### Chat Completion\n\nCreates a chat completion for the given conversation messages.\n\n#### POST /experts/{expert_id}/v2/chat/completions\n\n| Parameter  | Description                                |\n|------------|--------------------------------------------|\n| expert_id  | The ID of your expert (found in the portal) |\n\n##### Request Body\n\n```json\n{\n  "messages": [\n    {\n      "role": "user",\n      "content": "When can I play billiards?"\n    }\n  ],\n  "user": "user@example.com",\n  "stream": false,\n  "tags": ["tag1", "tag2"],\n  "tagFilterMode": "alt",\n  "folderIds": [1, 2, 3]\n}\n```\n\n| Field         | Type           | Required | Description                                                           |\n|---------------|----------------|----------|-----------------------------------------------------------------------|\n| messages      | array          | Yes      | List of messages comprising the conversation so far                   |\n| user          | string         | Yes      | Unique identifier for the end-user (for auditing purposes)            |\n| stream        | boolean        | No       | Whether to stream the response (default: false)                       |\n| tags          | array[string]  | No       | Knowledge tags to filter against (default: include all knowledges)    |\n| tagFilterMode | string         | No       | Tag matching mode: `"alt"` (match any tag) or `"all"` (match all); default: `"alt"` |\n| folderIds     | array[number]  | No       | Knowledges folder IDs to filter (default: include all knowledges)     |\n\n##### Response\n\n```json\n{\n  "choices": [\n    {\n      "message": {\n        "role": "assistant",\n        "content": "You can play billiards during the following timings: \n- 12:30 PM to 2:00 PM \n- 7:00 PM onwards \n\nYour invited guests are also required to follow these timings if they are playing games. [1]"\n      },\n      "index": 0,\n      "finish_reason": "stop"\n    },\n    {\n      "message": {\n        "role": "assistant",\n        "content": "{\\"content\\":\\"\\",\\"citations\\":[{\\"id\\":123,\\"source\\":\\"https://drive.google.com/file/d/1bgtKiE2v0CLtHPWUeyQjjQ1DymZI6Bho/view\\",\\"title\\":\\"Office Guideline\\"}],\\"disclaimer\\":\\"\\", \\"images\\":[{\\"id\\":8550,\\"source\\":\\"https://knowledge.alpha.insea.io/webapi/public/images/0dc60f2ce4580fd1443dcb8465432d0a\\",\\"content_type\\":\\"image/png\\",\\"name\\":\\"0dc60f2ce4580fd1443dcb8465432d0a\\"}]}"\n      },\n      "index": 1,\n      "finish_reason": "stop"\n    }\n  ],\n  "created": 1733116035,\n  "model": "gpt-4o-mini-2024-07-18",\n  "object": "chat.completion",\n  "usage": {\n    "prompt_tokens": 2468,\n    "completion_tokens": 51,\n    "total_tokens": 2519\n  }\n}\n```\n\n##### Response Structure\n\n| Field    | Description                                                |\n|----------|------------------------------------------------------------|\n| choices  | Array of completion choices (contains both content and metadata) |\n| created  | Unix timestamp of when the completion was created          |\n| model    | Model used for completion                                  |\n| usage    | Token usage statistics                                     |\n\nThe response contains two elements in the choices array:\n1. The first element (index 0) contains the actual response content\n2. The second element (index 1) contains metadata in JSON format\n\n##### Metadata Structure\n\nThe metadata is provided as a JSON string in the second element of the choices array and includes:\n\n```json\n{\n  "content": "",\n  "citations": [\n    {\n      "id": 123,\n      "source": "https://drive.google.com/file/d/1bgtKiE2v0CLtHPWUeyQjjQ1DymZI6Bho/view",\n      "title": "Office Guideline",\n      "last_update": 1733115000\n    }\n  ],\n  "disclaimer": "",\n  "images": [\n    {\n      "id": 8550,\n      "source": "https://knowledge.alpha.insea.io/webapi/public/images/0dc60f2ce4580fd1443dcb8465432d0a",\n      "content_type": "image/png",\n      "name": "0dc60f2ce4580fd1443dcb8465432d0a"\n    }\n  ]\n}\n```\n\n| Field      | Description                                                |\n|------------|------------------------------------------------------------|\n| citations  | Array of citation objects referencing source documents     |\n| disclaimer | Optional disclaimer text                                   |\n| images     | Array of image objects included in the response            |\n\n**Citation Object:**\n- **id**: Knowledge ID of the knowledge document\n- **title**: Title of the referenced knowledge document\n- **source**: URL of the referenced knowledge document\n- **last_update**: Unix timestamp of the last updated time of knowledge\n\n**Image Object:**\n- **id**: Unique identifier for the image\n- **source**: URL to access the image\n- **content_type**: MIME type of the image (e.g., "image/png")\n- **name**: Canonical name of the image\n\n##### Streaming Response\n\nWhen `stream: true`, the API returns a stream of server-sent events with the same structure:\n\n```\ndata: {"object":"chat.completion.chunk","created":1733105476,"model":"gpt-4o-mini-2024-07-18","choices":[{"index":0,"finish_reason":"","delta":{"role":"assistant","content":"You"}}]}\n\ndata: {"object":"chat.completion.chunk","created":1733114110,"model":"gpt-4o-mini-2024-07-18","choices":[{"index":0,"finish_reason":"","delta":{"role":"assistant","content":" can"}}]}\n\ndata: {"object":"chat.completion.chunk","created":1733114110,"model":"gpt-4o-mini-2024-07-18","choices":[{"index":0,"finish_reason":"","delta":{"role":"assistant","content":" play"}}]}\n\ndata: {"object":"chat.completion.chunk","created":1733114110,"model":"gpt-4o-mini-2024-07-18","choices":[{"index":0,"finish_reason":"","delta":{"role":"assistant","content":" 12:30 PM to 2:00 PM"}}]}\n\ndata: {"object":"chat.completion.chunk","created":1733114110,"model":"gpt-4o-mini-2024-07-18","choices":[{"index":0,"finish_reason":"","delta":{"role":"assistant","content":" 7:00 PM onwards"}}]}\n\ndata: {"object":"chat.completion.chunk","created":1733114110,"model":"gpt-4o-mini-2024-07-18","choices":[{"index":0,"finish_reason":"","delta":{"role":"assistant","content":"Your invited guests are also required to follow these timings if they are playing games. [1]"}}]}\n\ndata: {"object":"chat.completion.chunk","created":1733114110,"model":"gpt-4o-mini-2024-07-18","choices":[{"index":0,"finish_reason":"","delta":{"role":"assistant","content":"[1][Image 1]"}}]}\n\n// Final chunk containing metadata as a second element in the choices array\ndata: {"object":"chat.completion.chunk","created":1733114110,"model":"gpt-4o-mini-2024-07-18","choices":[{"index":0,"finish_reason":"","delta":{}},{"index":1,"finish_reason":"","delta":{"role":"assistant","content":"{"content":"","citations":[{"id":123,"source":"https://drive.google.com/file/d/1bgtKiE2v0CLtHPWUeyQjjQ1DymZI6Bho/view","title":"Office Guideline","last_update":1733115000}],"disclaimer":"","images":[{"id":8550,"source":"https://knowledge.alpha.insea.io/webapi/public/images/0dc60f2ce4580fd1443dcb8465432d0a","content_type":"image/png","name":"0dc60f2ce4580fd1443dcb8465432d0a"}] }"}}],"usage":{"prompt_tokens":2468,"completion_tokens":51,"total_tokens":2519}}\n\ndata: [DONE]\n```\n\n**Important**: Unlike non-streaming responses where metadata is provided immediately, in streaming responses the metadata is provided only in the final chunk as a separate element in the choices array (index 1). Clients should wait for the complete stream before processing metadata.\n\n### Legacy API (Deprecated)\n\n#### POST /experts/{expert_id}/v1/chat/completions\n\nThis endpoint is deprecated. Please use v2 for all new integrations.\n\n'})}},function(e){e.O(0,[2901,1664,8430,764,916,2888,9774,179],function(){return e(e.s=65406)}),_N_E=e.O()}]);