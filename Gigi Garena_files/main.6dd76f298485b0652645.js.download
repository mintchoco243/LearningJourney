],GAMES_PM_MAP:{},TAP_NGHE:"Tập nghề",CTV_THUONG_XUYEN_THEO_SAN_PHAM:"CTV thường xuyên (Lương theo sản phẩm)",CTV_THUONG_XUYEN_LUONG_CUNG:"CTV thường xuyên (Lương cứng mỗi tháng)",APPROVE_CENTER_USERS:[],FORM_19_USERS:[],VU_CHI_CONG:"",NGUYEN_DAC_BA_NHAT:"",NGUYEN_HONG_HANH:"",TRAN_TRUNG_KIEN:"",NGUYEN_NGOC_TRAM:"",VO_TUYEN_CHINH:"",NGUYEN_ANH_TUAN:"",LUU_DINH_PHUC:"",LEGAL_TEAM:[],FINANCE_TEAM:[],CNB_TEAM:[],UQ_TITLE:{"Nguyễn Đắc Bá Nhật":"Giám Đốc Vận Hành Game","Vũ Chí Công":"Tổng Giám Đốc","An Anh Vũ":"Trưởng Dự án Blockman Go","Nguyễn Thanh Bình":"Trưởng dự án Freefire","Nhan Phước Quang":"Trưởng dự án Fifa Online 4"},UQ_DATA:[{companyCode:"VEE",companyName:"CÔNG TY CỔ PHẦN GIẢI TRÍ VÀ THỂ THAO ĐIỆN TỬ VIỆT NAM",signer:"Nguyễn Đắc Bá Nhật",title:"Giám Đốc Vận Hành Game",uqNumber:"76-2022.VEE_HN/GUQ",date:"21/02/2022"},{companyCode:"BMI",companyName:"CÔNG TY TNHH DỊCH VỤ PHẦN MỀM BÌNH MINH",signer:"Nguyễn Đắc Bá Nhật",title:"Giám Đốc Vận Hành Game",uqNumber:"78-2022.BM_HN/GUQ",date:"21/02/2022"},{companyCode:"VHT",companyName:"Công ty TNHH dịch vụ phần mềm Hòa Thái",signer:"Nguyễn Đắc Bá Nhật",title:"Giám Đốc Vận Hành Game",uqNumber:"77-2022.LOL_HN/GUQ",date:"21/02/2022"}],FEEDBACK_42:[{id:"1",question:"Logical & Analytical thinking",questionDesc:"Hiểu được logic của sự kiện/mục tiêu của sản phẩm từ đó lên kế hoạch và hoàn thiện sản phẩm bàn giao theo đúng yêu cầu",choices:[{value:"1",label:"Nắm sơ lược yêu cầu của sự kiện, chưa có khả năng tự hình thành logic sự kiện và lên kế hoạch"},{value:"2",label:"Hiểu được logic sự kiện, từ đó hình thành được đầu mục công việc cho bản thân "},{value:"3",label:"Hiểu được tổng quan cả logic và mục tiêu, thể hiện được ra kết quả sản phẩm (readability, sustainability, testability, applicability, feasibility). Có thể tư vấn điều phối, lên kế hoạch dự án với các bên liên quan để đạt mục tiêu đó"},{value:"4",label:"Hiểu mục tiêu dài hạn của sản phẩm, nhìn nhận được nhiều yếu tố liên quan (các bên liên quan, xu hướng khách hàng, bài học quá khứ), từ đó phân tích đa chiều và lên kế hoạch dự đoán, từ vấn trước các vấn đề có thể xảy ra và phòng ngừa"}]},{id:"2",question:"Site quality",questionDesc:"Chất lượng sản phẩm: Chức năng, tốc độ và sự ổn định để đảm bảo trải nghiệm người dùng. Note: Vấn đề lớn là các vấn đề gây ảnh hưởng trực tiếp đến chỉ số của sự kiện và gây ảnh hưởng lớn đến trải nghiệm người dùng",choices:[{value:"1",label:"Có rất nhiều lỗi/vấn đề lớn sau khi launching"},{value:"2",label:"Có một số lỗi/vấn đề lớn sau khi launching"},{value:"3",label:"Có một số lỗi/vấn đề nhỏ và không có vấn đề lớn sau khi launching"},{value:"4",label:"Không có lỗi/vấn đề nào sau khi launching"}]},{id:"3",question:"Communication & Collaboration",questionDesc:"Team dev chủ động giao tiếp, hỗ trợ và đóng góp",choices:[{value:"1",label:"Nhận thông tin một chiều từ khách hàng"},{value:"2",label:"Nghe, hiểu yêu cầu và trả lời thông tin theo yêu cầu của khách hàng"},{value:"3",label:"Chủ động trao đổi hai chiều, tham gia thảo luận để làm rõ yêu cầu của khách hàng, đưa ra nhận định của bản thân mang tính xây dựng và có thể thống nhất được ý kiến chung. Có khả năng quản lý và điều phối dự án nhỏ, team nhỏ"},{value:"4",label:"Chủ động nghiên cứu, tổng hợp dữ liệu để tư vấn lựa chọn hiệu quả nhất cho khách hàng. Chủ động chia sẻ kiến thức để xây dựng năng lực cho khách hàng và thúc đẩy phối hợp làm việc hiệu quả. Có khả năng quản lý điều phối dự án lớn, team gồm nhiều bộ phận cùng tham gia"}]},{id:"4",question:"Timeliness",questionDesc:"Tiến độ của dự án",choices:[{value:"1",label:"Thường xuyên trễ tasks và/hoặc không đảm bảo được thời gian testing cho một số dự án/ nhiệm vụ"},{value:"2",label:"Đôi khi trễ tasks và/hoặc không đảm bảo được thời gian testing cho một số dự án/ nhiệm vụ"},{value:"3",label:"Thường xuyên hoàn thành các tasks đúng hạn, đảm bảo sản phẩm cuối cùng ra theo đúng tiến độ dự kiến "},{value:"4",label:"Luôn luôn hoàn thành tasks đúng và trước thời hạn, chủ động đảm bảo thời gian cho testing của dự án"}]},{id:"5",question:"Overall",questionDesc:"Nhìn chung, tôi thấy hài lòng với dự án đã hoàn thành",choices:[{value:"1",label:"Rất không đồng ý"},{value:"2",label:"Không đồng ý"},{value:"3",label:"Đồng ý"},{value:"4",label:"Rất đồng ý"}]}],INITIAL_TASKS:{READY_FOR_CKS:"Hợp đồng đã được kiểm tra, có thể tiến hành ký Chữ ký số"},DEFAULT_FORM_NODES:[{form_name:"vat",nodes:[{is_leaf:!1,leaf_html:"",parent:null,question:"Tra cứu mã số thuế",is_root:!0,depth:0,node_id:1,answer:"",path:[1],children:[2,3,4,5]},{is_leaf:!0,leaf_html:"<p>\nCÔNG TY CỔ PHẦN GIẢI TRÍ VÀ THỂ THAO ĐIỆN TỬ VIỆT NAM<br/>\n\nMã số thuế: 0105301438<br/>\n\nĐịa chỉ: Tầng 6, Tòa nhà Capital Place, 29 Liễu Giai, Phường Ngọc Hà, Thành phố Hà Nội, Việt Nam\n</p>",parent:1,question:"",is_root:!1,depth:1,node_id:2,answer:"CÔNG TY CỔ PHẦN GIẢI TRÍ VÀ THỂ THAO ĐIỆN TỬ VIỆT NAM",path:[1,2],children:[]},{is_leaf:!0,leaf_html:"\n<p>\nCÔNG TY TNHH DỊCH VỤ PHẦN MỀM BÌNH MINH<br/>\n\nMã số thuế: 0106803303\n<br/>\n\nĐịa chỉ: Tầng 6, Tòa nhà Capital Place, 29 Liễu Giai, Phường Ngọc Hà, Thành phố Hà Nội, Việt Nam\n</p>",parent:1,question:"",is_root:!1,depth:1,node_id:3,answer:"CÔNG TY TNHH DỊCH VỤ PHẦN MỀM BÌNH MINH",path:[1,3],children:[]},{is_leaf:!0,leaf_html:"<p>\nCÔNG TY TNHH DỊCH VỤ PHẦN MỀM THIÊN BÌNH<br/>\n\nMã số thuế: 0106803215\n<br/>\n\nĐịa chỉ: Tầng 6, Tòa nhà Capital Place, 29 Liễu Giai, Phường Ngọc Hà, Thành phố Hà Nội, Việt Nam\n</p>",parent:1,question:"",is_root:!1,depth:1,node_id:4,answer:"CÔNG TY TNHH DỊCH VỤ PHẦN MỀM THIÊN BÌNH",path:[1,4],children:[]},{is_leaf:!0,leaf_html:"<p>\nCông ty TNHH dịch vụ phần mềm Hòa Thái<br/>\n\nMã số thuế: 2801724858\n<br/>\n\nĐịa chỉ: Tầng 6, Tòa nhà Capital Place, 29 Liễu Giai, Phường Ngọc Hà, Thành phố Hà Nội, Việt Nam\n</p>",parent:1,question:"",is_root:!1,depth:1,node_id:5,answer:"Công ty TNHH dịch vụ phần mềm Hòa Thái",path:[1,5],children:[]}],form_id:6}],DEFAULT_NODES:[{is_leaf:!1,is_root:!0,parent:null,node_name:"T