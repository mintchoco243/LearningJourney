:"6",label:"6",value:!1,text:"Đăng ký cơm trưa (nếu có)",dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"7",label:"7",value:!1,text:"Được tham quan và giới thiệu về các khu vực tại văn phòng",dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"8",label:"8",value:!1,text:"Nhận hộp welcome kit",dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"8",label:"8",value:!1,text:"Nhận thẻ gửi xe và ra vào tòa nhà",dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"9",label:"9",value:!1,text:"Nhận đầy đủ thiết bị và công cụ làm việc",dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"10",label:"10",value:!1,text:"Được tham gia Orientation Training - HR Briefing",dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"11",label:"11",value:!1,text:"Được tham gia Orientation Training - PM Briefing",dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"12",label:"12",value:!1,text:"Được tham gia Orientation Training - Supervisor Briefing",dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"13",label:"13",value:!1,text:"Được hoàn thành Payslip demo",dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"14",label:"14",value:!1,text:"Nộp hồ sơ nhân sự cho C&B",dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"15",label:"15",value:!1,text:"Ký hợp đồng và thỏa thuận hạn chế giao kết hợp đồng",dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"16",label:"16",value:!1,text:'Đăng nhập vào Sailor Platform - mạng xã hội nội bộ của Garena tại <a href="https://sailor.garena.vn" target="_blank">sailor.garena.vn</a> (sử dụng mail công ty) và đọc hướng dẫn tại phần <a href="https://drive.google.com/file/d/1MG4nIDerfDqMSdV8FaXpf9JqA7JSkW7x/view" target="_blank">Trợ giúp</a>',dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"17",label:"17",value:!1,text:'Bạn có thể gửi thông tin User ID của mình tại <a href="https://forms.gle/7WRib4xpGZgP1ShZ6" target="_blank">ĐÂY</a> để nhận quà quay / đổi được từ Sailor',dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"18",label:"18",value:!1,text:"Nhận thông tin tài liệu và thông tin lịch trình thử việc",dueBefore:0,belongsTo:"cp4",subgroup:"Onboarding"},{name:"19",label:"19",value:!1,text:"Trao đổi giữa kỳ thử việc giữa nhân viên mới và quản lý",dueBefore:-25,belongsTo:"cp4",subgroup:"Catch-up giữa kì thử việc"},{name:"20",label:"20",value:!1,text:"Trao đổi giữa kỳ thử việc giữa nhân viên mới và HR",dueBefore:-26,belongsTo:"cp4",subgroup:"Catch-up giữa kì thử việc"},{name:"21",label:"21",value:!1,text:'Gửi đánh giá trải nghiệm onboarding và probation tại <a target="_blank" href="https://forms.gle/y2kGYCs8GzFQgiNfA">LINK</a>',dueBefore:-27,belongsTo:"cp4",subgroup:"Catch-up giữa kì thử việc"},{name:"22",label:"22",value:!1,text:'Nhân viên mới gửi bản nháp slide đầu tiên cho HR & Quản lý qua email (lưu ý gửi bản google slides mở access comment) sau đó nhận feedback và điều chỉnh\nTemplate: <a target="_blank" href="https://docs.google.com/presentation/u/1/d/1gz9yIisMaD8BbP5moh1a7oFbsp0-ojs8/edit?usp=drive_link&ouid=106903727602178885851&rtpof=true&sd=true">End-Probation Presentation Template.</a>\nBài mẫu tham khảo: <a target="_blank" href="https://drive.google.com/drive/folders/1IpjFQUZ_2g7PjT_LMGW-Vnu9Rcgp6I6R?usp=sharing">Ref Deck</a>',dueBefore:-40,belongsTo:"cp4",subgroup:"Trình bày kết thúc thử việc"},{name:"23",label:"23",value:!1,text:"Trình bày kết thúc thử việc, đánh giá thử việc và chia sẻ các kỳ vọng sau thử việc\nThành phần tham dự: Quản lý trực tiếp, PM, HRBP, Country Head",dueBefore:-50,belongsTo:"cp4",subgroup:"Trình bày kết thúc thử việc"},{name:"24",label:"24",value:!1,text:"Nhận thông báo kết quả đánh giá thử việc",dueBefore:-51,belongsTo:"cp4",subgroup:"Trình bày kết thúc thử việc"}]},42:{formName:"Web event project request/Đăng ký dự án Microsite với team CODE",order:["admins","fullname","email","game","includesIngameItems","projectName","projectGit","projectType","shortMechanismDescription","mockupLink","dataLink","des