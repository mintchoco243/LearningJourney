PORT=3000
NODE_ENV=development

DATABASE_URL=mysql://user:password@host:3306/learning_journey

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local default. Set this to https://learningcompass.garena.vn/auth/callback in production.
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback

JWT_SECRET=replace-with-a-random-64-character-secret-before-deploying
AUTH_SESSION_DAYS=30
AUTH_RENEW_BEFORE_DAYS=7
AUTH_TOKEN_VERSION=2
AUTH_ACCEPT_LEGACY_TOKENS=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=learning-hub@garena.vn
LD_ADMIN_EMAIL_GROUP=ld-team@garena.vn

AI_CHAT_ENDPOINT=
AI_CHAT_API_KEY=

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_PROPERTY_ID=123456789
# Paste the full Google service account JSON on one line, or use GA_SERVICE_ACCOUNT_JSON_BASE64 instead.
GA_SERVICE_ACCOUNT_JSON=
GA_SERVICE_ACCOUNT_JSON_BASE64=
GA_REPORT_RANGE=30daysAgo

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Development only. When true, /auth/dev-login creates a @garena.vn session.
# Defaults to false when NODE_ENV=production.
DEV_AUTH_ENABLED=true
